  "sampleLimit": 20,
  "probeLimit": 50,
  "explorationCatalog": {
    "productLabel": "U1",
    "plannerTask": "bounded NY taxi zone lookup exploration",
    "observations": {
      "observedTaxiZoneIds": {
        "fromTable": "yellow_taxi",
        "column": "PULocationID",
        "pattern": "^\\d{1,4}(?:\\.0)?$",
        "max": 20
      },
      "observedZoneIds": {
        "fromTable": "trips",
        "column": "pickup_zone_id",
        "pattern": "^[A-Za-z0-9_-]{1,36}$",
        "max": 20
      }
    },
    "actions": [
      {
        "id": "READ_TAXI_ZONE_LOOKUP",
        "kind": "KEYED_READ",
        "table": "taxi_zones",
        "filterColumn": "LocationID",
        "observation": "observedTaxiZoneIds",
        "requiredColumns": [
          "LocationID"
        ],
        "description": "Bounded taxi zone rows for observed yellow taxi pickup ids"
      },
      {
        "id": "READ_ZONES_REFERENCE",
        "kind": "KEYED_READ",
        "table": "zones",
        "filterColumn": "zone_id",
        "observation": "observedZoneIds",
        "requiredColumns": [
          "zone_id"
        ],
        "description": "Bounded zones rows for observed trip pickup zone ids"
      }
    ]
  },
  "probeMode": "distinct-keys"
